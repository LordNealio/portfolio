# ── N-Word study Phase 2 environment ─────────────────────────────────────────
# Copy to .env for local dev, and set these in the Vercel project settings for
# production. LEAVE ENROLLMENT OFF until independent/IRB review is complete.

# Client-visible flag (Vite). When "true", the study page will attempt to save
# responses via the API. Default/absent = preview mode (nothing is collected).
VITE_RESEARCH_ENROLLMENT_ENABLED=false

# Server-side master gate. BOTH this and the Supabase secrets must be present for
# any API endpoint to write data. Keep "false" until go-live is approved.
RESEARCH_ENROLLMENT_ENABLED=false

# Supabase — server only. The service-role key must NEVER be exposed to the
# browser or committed. It is used solely by the /api functions.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Admin dashboard bearer token (choose a long random string). Required to read
# /api/study/admin/*.
STUDY_ADMIN_TOKEN=

# ── Reconvening the 34 ───────────────────────────────────────────────────────
# A SEPARATE gate from the study above. This is community feedback, not IRB-
# gated research, so the two are never opened by the same switch.
#
# Client-visible flag (Vite). When "true", the ballot and the contribution form
# will post to the API. Default/absent = the UI plainly says submissions are not
# open and offers a downloadable copy instead of pretending to store anything.
VITE_RECONVENE_ENABLED=false

# Server-side master gate. BOTH this and the Supabase secrets above must be
# present for any /api/reconvene endpoint to write.
RECONVENE_ENABLED=false

# Bearer token for /api/reconvene/admin/export. Falls back to STUDY_ADMIN_TOKEN
# if unset; set it separately to keep the two exports independently revocable.
RECONVENE_ADMIN_TOKEN=

# Salt for the disposable per-IP hash used only for rate limiting. Raw IPs are
# never stored. Any long random string works.
RECONVENE_IP_SALT=
