# ── N-Word study Phase 2 environment ─────────────────────────────────────────
# Copy to .env for local dev, and set these in the Vercel project settings for
# production. LEAVE ENROLLMENT OFF until independent/IRB review is complete.

# Client-visible flag (Vite). When "true", the study page will attempt to save
# responses via the API. Default/absent = preview mode (nothing is collected).
VITE_RESEARCH_ENROLLMENT_ENABLED=false

# Server-side master gate. BOTH this and the Supabase secrets must be present for
# any API endpoint to write data. Keep "false" until go-live is approved.
RESEARCH_ENROLLMENT_ENABLED=false

# Supabase — server only. The service-role key must NEVER be exposed to the
# browser or committed. It is used solely by the /api functions.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Admin dashboard bearer token (choose a long random string). Required to read
# /api/study/admin/*.
STUDY_ADMIN_TOKEN=
